# Copy this file to .env and fill in real values.
# NEVER commit .env — real keys must stay out of source control.

# --- Supabase (frontend-safe values) ---
# From Supabase dashboard: Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (server-side ONLY) ---
# From Supabase dashboard: Project Settings > API > service_role
# Never used in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (server-side ONLY) ---
# From https://resend.com/api-keys
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=basco.pk@gmail.com
BOOKING_TO_EMAIL=basco.pk@gmail.com

# --- OpenRouter (server-side ONLY) ---
# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Salman OS project feed (server-side ONLY) ---
# Secure Salman OS base URL, for example https://salman-os-swart.vercel.app
SALMAN_OS_BASE_URL=
# Must match Salman OS PROJECTS_FEED_TOKEN. Never use a VITE_ prefix.
PROJECTS_FEED_TOKEN=

# --- Site ---
# Canonical origin. Defaults to https://salmanbashir.vercel.app if unset.
APP_URL=https://salmanbashir.vercel.app
